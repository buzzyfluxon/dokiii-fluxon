{
  "name": "dokiii",
  "version": "1.0.0",
  "description": "DOKIII — Windows Desktop Dock",
  "main": "dist/main/main.js",
  "author": "buzzyfluxon",
  "homepage": "https://github.com/buzzyfluxon",
  "repository": {
    "type": "git",
    "url": "https://github.com/buzzyfluxon"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.node.json --watch\" \"electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json && node -e \"const fs=require('fs');const p=require('path');const d=p.join('dist','setup');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join('src','setup','setup.html'),p.join(d,'setup.html'));fs.copyFileSync(p.join('src','setup','uninstall.html'),p.join(d,'uninstall.html'));\"",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "pack": "electron-builder --dir && node scripts/embed-icon.js && node -e \"const fs=require('fs');const p=require('path');fs.cpSync(p.resolve('release','win-unpacked'),p.resolve('release','DOKIII'),{recursive:true,force:true});\" && node scripts/embed-icon.js \"release/DOKIII/DOKIII.exe\"",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
