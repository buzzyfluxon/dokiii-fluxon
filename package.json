{
  "name": "dokiii",
  "version": "1.4.2",
  "description": "DOKIII — a macOS-style dock, floating music player and desktop widgets for Windows",
  "main": "dist/main/main.js",
  "author": "fluxonbuzz",
  "homepage": "https://github.com/buzzyfluxon/dokiii-fluxon",
  "repository": {
    "type": "git",
    "url": "https://github.com/buzzyfluxon/dokiii-fluxon.git"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.node.json --watch\" \"electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "pack": "electron-builder --publish never",
    "dist": "npm run build && npm run pack",
    "release": "npm run build && electron-builder --publish always",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "license": "MIT"
}
